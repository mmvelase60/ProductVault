@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav ms-lg-auto align-items-lg-center account-navigation">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item"><a class="nav-link account-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">@User.Identity?.Name</a></li>
    <li class="nav-item"><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"><button type="submit" class="btn btn-sm btn-outline-light ms-lg-2">Sign out</button></form></li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Sign in</a></li>
    <li class="nav-item"><a class="btn btn-sm btn-light ms-lg-2" asp-area="Identity" asp-page="/Account/Register">Create account</a></li>
}
</ul>
