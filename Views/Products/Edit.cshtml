@model ProductInputViewModel
@{ ViewData["Title"] = "Edit product"; }
<section class="form-page"><p class="eyebrow">Catalogue</p><h1>Edit product</h1><p class="text-muted">Keep product details accurate for everyone who relies on this workspace.</p><form asp-action="Edit" enctype="multipart/form-data" class="form-card"><input asp-for="ProductId" type="hidden" /><input asp-for="RowVersion" type="hidden" /><input asp-for="ExistingImagePath" type="hidden" /><partial name="_Form" model="Model" /><div class="form-actions"><button class="btn btn-primary">Save changes</button><a class="btn btn-link" asp-action="Index">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
