@model ProductIndexViewModel
@{ ViewData["Title"] = "Products"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1>Products</h1><p class="text-muted mb-0">@Model.TotalCount product@(Model.TotalCount == 1 ? "" : "s") in your catalogue.</p></div><div><a class="btn btn-outline-success" asp-action="Export">Download Excel</a><a class="btn btn-primary" asp-action="Create">Add product</a></div></div>
<form asp-action="Import" method="post" enctype="multipart/form-data" class="card card-body bg-light mb-3"><div class="row align-items-end g-2"><div class="col-md-8"><label class="form-label" for="file">Import products (.xlsx)</label><input type="file" name="file" id="file" class="form-control" accept=".xlsx" /><div class="form-text">Columns: Name, Description, Category Code, Price. Your category must already exist and be active.</div></div><div class="col-md-4"><button class="btn btn-outline-primary">Import Excel</button></div></div></form>
@if (!Model.Products.Any()) { <div class="alert alert-info">No products yet. Add one manually or import an Excel file.</div> }
else { <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th></th><th>Code</th><th>Name</th><th>Category</th><th class="text-end">Price</th><th></th></tr></thead><tbody>@foreach (var product in Model.Products) { <tr><td style="width:48px">@if (!string.IsNullOrEmpty(product.ImagePath)) { <img src="@product.ImagePath" alt="" class="rounded object-fit-cover" width="40" height="40" /> }</td><td><code>@product.ProductCode</code></td><td>@product.Name</td><td>@product.Category?.Name</td><td class="text-end">@product.Price.ToString("C")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.ProductId">Edit</a><form asp-action="Delete" asp-route-id="@product.ProductId" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr> }</tbody></table></div>
    @if (Model.TotalPages > 1) { <nav aria-label="Product pages"><ul class="pagination">@for (var i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" asp-route-page="@i">@i</a></li> }</ul></nav> }
}
