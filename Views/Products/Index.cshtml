@model ProductIndexViewModel
@{ ViewData["Title"] = "Products"; }

<section class="page-heading">
    <div><p class="eyebrow">Catalogue</p><h1>Products</h1><p class="text-muted mb-0">@Model.TotalCount product@(Model.TotalCount == 1 ? "" : "s") in your private workspace.</p></div>
    <div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-success" asp-action="Export">Download Excel</a><a class="btn btn-primary" asp-action="Create">Add product</a></div>
</section>

<section class="content-card mb-4">
    <form method="get" class="catalogue-filters">
        <div class="search-field"><label class="visually-hidden" for="search">Search products</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Search name, code, or description" /></div>
        <div><label class="visually-hidden" for="categoryId">Filter by category</label><select class="form-select" id="categoryId" name="categoryId"><option value="">All categories</option>@foreach (var category in Model.Categories) { <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">@category.Name</option> }</select></div>
        <div><label class="visually-hidden" for="sort">Sort products</label><select class="form-select" id="sort" name="sort"><option value="newest" selected="@(Model.Sort == "newest")">Newest first</option><option value="name" selected="@(Model.Sort == "name")">Name A–Z</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Price: low to high</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Price: high to low</option><option value="code" selected="@(Model.Sort == "code")">Product code</option></select></div>
        <button class="btn btn-dark">Apply</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || Model.Sort != "newest") { <a class="btn btn-link" asp-action="Index">Clear</a> }
    </form>
</section>

<details class="import-panel mb-4"><summary><span><strong>Import from Excel</strong><small>Add up to 500 products at once</small></span><span aria-hidden="true">+</span></summary><form asp-action="Import" method="post" enctype="multipart/form-data" class="import-panel-body"><div><label class="form-label" for="file">Excel workbook (.xlsx)</label><input type="file" name="file" id="file" class="form-control" accept=".xlsx" /><p class="form-text mb-0">Columns: Name, Description, Category Code, Price. Categories must already exist and be active.</p></div><button class="btn btn-outline-primary">Import products</button></form></details>

@if (!Model.Products.Any())
{
    <section class="empty-state"><span class="empty-icon">□</span><h2>@(Model.TotalCount == 0 ? "No products yet" : "No products match these filters")</h2><p>@(Model.TotalCount == 0 ? "Add a product manually or bring in your existing catalogue from Excel." : "Try a different search, category, or sort order.")</p>@if (Model.TotalCount == 0) { <a class="btn btn-primary" asp-action="Create">Add your first product</a> } else { <a class="btn btn-outline-primary" asp-action="Index">Clear filters</a> }</section>
}
else
{
    <section class="content-card table-card">
        <div class="table-responsive"><table class="table catalogue-table align-middle mb-0"><thead><tr><th>Product</th><th>Code</th><th>Category</th><th class="text-end">Price</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
        @foreach (var product in Model.Products)
        {
            <tr><td><div class="product-cell">@if (!string.IsNullOrWhiteSpace(product.ImagePath)) { <img src="@product.ImagePath" alt="" /> } else { <span class="product-placeholder">@product.Name[..1].ToUpperInvariant()</span> }<div><strong>@product.Name</strong>@if (!string.IsNullOrWhiteSpace(product.Description)) { <small>@product.Description</small> }</div></div></td><td><code>@product.ProductCode</code></td><td><span class="category-chip">@product.Category?.Name</span></td><td class="text-end fw-semibold">@product.Price.ToString("C")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.ProductId">Edit</a><form asp-action="Delete" asp-route-id="@product.ProductId" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');"><button class="btn btn-sm btn-link text-danger">Delete</button></form></td></tr>
        }
        </tbody></table></div>
        @if (Model.TotalPages > 1)
        {
            <nav class="table-pagination" aria-label="Product pages"><span>Page @Model.CurrentPage of @Model.TotalPages</span><ul class="pagination mb-0">@for (var i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-sort="@Model.Sort">@i</a></li> }</ul></nav>
        }
    </section>
}
