@model ProductInputViewModel
@{ ViewData["Title"] = "Add product"; }
<h1>Add product</h1><p class="text-muted">The product code is generated automatically when you save.</p><form asp-action="Create" enctype="multipart/form-data" class="col-lg-7"><partial name="_Form" model="Model" /><button class="btn btn-primary">Save product</button><a class="btn btn-link" asp-action="Index">Cancel</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
